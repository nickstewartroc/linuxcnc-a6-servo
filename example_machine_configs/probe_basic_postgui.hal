#####
##### Time(r) setup for Probe basic
#####

loadrt time
loadrt not

addf time.0 servo-thread
addf not.0 servo-thread

net prog-running not.0.in <= halui.program.is-idle
net prog-paused halui.program.is-paused => time.0.pause
net cycle-timer time.0.start <= not.0.out
net cycle-seconds qtpyvcp.timerseconds.in <= time.0.seconds
net cycle-minutes qtpyvcp.timerminutes.in <= time.0.minutes
net cycle-hours qtpyvcp.timerhours.in <= time.0.hours
# *** Time items required for Probe Basic to run ***


#####
##### Tool changer setup
#####
#  ---manual tool change signals---
net tool-change-request     =>  qtpyvcp_manualtoolchange.change
net tool-change-confirmed   <=  qtpyvcp_manualtoolchange.changed
net tool-number             =>  qtpyvcp_manualtoolchange.number


#####
##### Probe setup
#####
# *** Probe graphic simulation trigger push probe tip ***
#net probe-in  =>  qtpyvcp.probe-in.out
net probe-in  <=  qtpyvcp.probe-led.on

# *** Set line below for actual spindle readout from your hal file ***
# net spindle-rpm-filtered scale_to_rpm.out  =>  qtpyvcp.spindle-encoder-rpm.in

#####
##### VFD Spindle Setup
#####
loadusr -W mb2hal config=MB2HALConfig.ini

####
#### RPM scaling setup
####

loadrt scale names=spindle_load,rpm_to_vfd_hz,vfd_hz_to_rpm
loadrt abs names=spindle_abs
addf spindle_load servo-thread
addf rpm_to_vfd_hz servo-thread
addf spindle_abs servo-thread

# Set scaling between hz and RPM
setp rpm_to_vfd_hz.gain 2
setp rpm_to_vfd_hz.offset 0

# Link spindle speed to scale
net spindle-speed-raw <= spindle.0.speed-out
net spindle-speed-raw => spindle_abs.in

# Setup abs
net spindle-speed-abs <= spindle_abs.out
net spindle-speed-abs => rpm_to_vfd_hz.in

# Link scale output to mb2hal
net vfd-hz-command <= rpm_to_vfd_hz.out
net vfd-hz-command => mb2hal.set-hz.00#.float

####
#### FWD/REV/STOP setup
####

# 1. Load two multiplexers
loadrt mux2 names=mux_fwd,mux_rev
addf mux_fwd servo-thread
addf mux_rev servo-thread

# 2. Setup Forward Logic
# If spindle-fwd is false, output is 0. If true, output is 1.
setp mux_fwd.in0 0
setp mux_fwd.in1 1
net spindle-fwd      => mux_fwd.sel

# 3. Setup Reverse Logic (The Override)
# If spindle-rev is false, pass through Mux A's value. If true, output 2.
net fwd-logic-out    <= mux_fwd.out
net fwd-logic-out    => mux_rev.in0
setp mux_rev.in1 2
net spindle-rev      => mux_rev.sel

# 4. Send final integer to mb2hal
net vfd-command-int  <= mux_rev.out
net vfd-command-int  => mb2hal.set-direction.00#.float

# 5. Connect to LinuxCNC Spindle Pins
net spindle-fwd      <= spindle.0.forward
net spindle-rev      <= spindle.0.reverse


####
#### Reading from VFD back to LinuxCNC
####
# 1. Load another scale component for the return path
#loadrt scale names=vfd_hz_to_rpm
addf vfd_hz_to_rpm servo-thread

# 2. Set the gain (Match your motor's math)
# Example: VFD sends 6000 (for 60Hz), you want to see 1800 RPM. 
# 1800 / 6000 = 0.3
setp vfd_hz_to_rpm.gain 0.5
setp vfd_hz_to_rpm.offset 0

# 3. Connect mb2hal to the scale component
net vfd-raw-feedback    <= mb2hal.output-frequency.00.float
net vfd-raw-feedback    => vfd_hz_to_rpm.in

# 4. Connect to LinuxCNC Spindle Feedback Pin
net spindle-vel-cmd-rpm    <= vfd_hz_to_rpm.out
net spindle-vel-cmd-rpm    => spindle.0.speed-in

net spindle-vel-cmd-rpm =>  qtpyvcp.spindle-encoder-rpm.in


####
#### Set Spindle load
####
setp spindle_load.gain 0.01 #Sets the ratio
net spindle-load-abs mb2hal.actual-torque.00.float => spindle_load.in
net spindle-load-scale spindle_load.out => qtpyvcp.spindle-load-indicator.in-f

####
#### Setup the operating state
####
# 1. Load the conversion component and the bitslice component
loadrt conv_s32_u32 names=vfd_conv

# 2. Add them to the thread
addf vfd_conv servo-thread
addf vfd_status servo-thread

# 3. Connect mb2hal (s32) to the Converter input (s32)
net vfd-status-raw-s32 mb2hal.operating-state.00.int => vfd_conv.in

# 4. Connect the Converter output (u32) to the Bitslice input (u32)
net vfd-status-raw-u32 vfd_conv.out => vfd_status.in

# 5. Now you can use the individual bit pins as before
#net vfd-is-faulted vfd_status.out-11 => [your_signal_here]

# 0: FWD: Forward operation
# 1: REV:0: Reverse operation
# 2: EXT: DC braking active  (or pre-excitation)
# 3: INT: No Output
# 4: BRK: Braking active
# 5: NUV: DC link voltage is established
# 6: TL: Torque limiting
# 7: VL: Voltage limiting
# 8: IL: Current limiting
# 9: ACC: Under acceleration
# 10: DEC: Under deceleration
# 11: ALM: Drive fault
# 12: RL: Transmission valid
# 13/14: WR: Function writing privlege
# 	0: Keypad panel
# 	1: RS485
# 	2: Fieldbus (option)
# 15: BUSY: Processing data write

#####
##### Tool changer setup
#####
loadrt carousel pockets=12 dir=2 encoding=index
loadrt conv_float_s32 count=1
addf carousel.0 servo-thread
addf conv-float-s32.0 servo-thread # G-code analogue outputs are float-type

net car-enable carousel.0.enable
net car-ready carousel.0.ready
net car-cw motion.digital-out-03 => mb2hal.outputs.carousel-cw
net car-ccw motion.digital-out-04 => mb2hal.outputs.carousel-ccw
net car-pos-req motion.analog-out-00 conv-float-s32.0.in
net car-pos-s32 conv-float-s32.0.out carousel.0.pocket-number
net index carousel.0.sense-0 motion.digital-in-03 <=  mb2hal.inputs.carousel-index
net pulse carousel.0.sense-1 motion.digital-in-04 <=  mb2hal.inputs.carousel-pulse

net arm-act  motion.digital-out-00 => mb2hal.outputs.carousel-arm
net arm-in motion.digital-in-01 <=  mb2hal.inputs.carousel-in
net arm-out  motion.digital-in-00 <=  mb2hal.inputs.carousel-out

net tool-release motion.digital-out-02 => mb2hal.outputs.tool-release

# --- Orient Plunger ---
net orient motion.digital-out-05 => mb2hal.outputs.orient-pin
# --- Orient Pin ---
net orient-pin motion.digital-in-05 <=  mb2hal.inputs.orient-pin

net tool-prep-loop iocontrol.0.tool-prepare iocontrol.0.tool-prepared
net tool-change-loop iocontrol.0.tool-change iocontrol.0.tool-changed

#####
##### MISC IO Setup
#####

# --- Air Switch ---
net air-switch     	<=  mb2hal.inputs.air-switch

# --- Coolant Control ----
net coolant iocontrol.0.coolant-mist => mb2hal.outputs.mist-coolant


# --- Setup Power On Relay ---
net machine-is-on motion.motion-enabled => mb2hal.outputs.mill-enable
